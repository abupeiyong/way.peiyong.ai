{
  "name": "way",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy -c dist/way/wrangler.json",
    "db:migrate:local": "wrangler d1 migrations apply way-preview-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply way-preview-db --remote",
    "telegram:setup": "curl -fsS -X POST -H \"Authorization: Bearer $TELEGRAM_WEBHOOK_SECRET\" \"${WAY_URL:-https://way.peiyong.ai}/api/telegram/setup\"",
    "check:telegram": "node worker/telegram/api.check.ts",
    "check:workout": "node worker/telegram/workout.check.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "way-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "way-preview-db",
      "database_id": "42099652-fbee-456f-81e9-56be0fd3d418",
      "migrations_dir": "migrations"
    }
  ],
  // Telegram scheduler tick (worker/telegram/schedule.ts → runSchedules). Locally (vite plugin): curl "http://localhost:5174/cdn-cgi/handler/scheduled".
  "triggers": { "crons": ["*/5 * * * *"] },
  "ratelimits": [
    // PRD §11.2: 5 attempts per IP per minute across /api/auth/*; 10 bot messages per user per minute.
    // namespace_id is an arbitrary integer, unique per Cloudflare account.
    { "name": "AUTH_LIMITER", "namespace_id": "1201", "simple": { "limit": 5, "period": 60 } },
    { "name": "TG_FLOOD_LIMITER", "namespace_id": "1202", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_CHAT_MODEL": "gpt-5-nano"
  }
}

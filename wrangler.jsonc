{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "way",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "way.peiyong.ai", "custom_domain": true }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "way-preview-db",
      "database_id": "42099652-fbee-456f-81e9-56be0fd3d418",
      "migrations_dir": "migrations"
    }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    // Way Guide 优先走 OpenAI 兼容接口(OPENAI_API_KEY 用 wrangler secret 配);
    // 没配 key 时自动退回 Workers AI(免费,质量略低)
    "OPENAI_BASE_URL": "https://api.openai.com/v1",
    "OPENAI_CHAT_MODEL": "gpt-5-nano"
  },
  "observability": { "enabled": true }
}
